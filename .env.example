# Copy to .env and fill in. Everything is optional: with no key the agent runs fully
# offline (keyword router + rule/template tools) so it can be evaluated without an LLM.

# LLM provider: openai | anthropic | groq | ollama (any provider supported by LangChain's
# init_chat_model). Leave empty to auto-detect from whichever API key below is set.
LLM_PROVIDER=
# Optional model override. Defaults: openai=gpt-4o-mini, anthropic=claude-opus-5-5
LLM_MODEL=
LLM_TEMPERATURE=0.2   # ignored for Anthropic (current Claude models use the default)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Force offline mode even if a key is present (1/true)
OFFLINE=

# Routing below this confidence asks the user to clarify instead of guessing (0-1)
MIN_ROUTE_CONFIDENCE=0.35

# Where workflows come from and where results go
WORKFLOW_EXCEL=data/AI_Agent_Workflow_Assessment.xlsx
WORKFLOW_BINDINGS=config/workflow_bindings.yaml
OUTPUT_DIR=outputs
RUN_LOG=runs/execution_log.csv
