# Copy to .env and fill in. Everything is optional for local use: with no key the agent runs fully
# offline (keyword router + rule/template tools) on SQLite and simulated services.

# --- environment ----------------------------------------------------------------------------
# development | production. Production refuses to start without API_KEYS and PostgreSQL.
APP_ENV=development
# Project root for relative paths (set automatically; needed only for unusual installs)
APP_ROOT=

# --- LLM ------------------------------------------------------------------------------------
# openai | anthropic | groq | ollama (any provider supported by LangChain's init_chat_model).
# Leave empty to auto-detect from whichever API key below is set.
LLM_PROVIDER=
# Optional model override. Defaults: openai=gpt-4o-mini, anthropic=claude-opus-5-5
LLM_MODEL=
# ignored for Anthropic (current Claude models use the default)
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 1 = ignore any configured LLM
OFFLINE=

LLM_TIMEOUT_SEC=60
# client-side rate limit
LLM_REQUESTS_PER_SECOND=5
# per-run budget; when reached, steps use their deterministic fallback
MAX_LLM_CALLS_PER_RUN=20
MAX_LLM_COST_PER_RUN_USD=0.50
# USD per 1M tokens, for models not in the built-in price table
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- agent behaviour ------------------------------------------------------------------------
# below this the agent asks the user to clarify (0-1)
MIN_ROUTE_CONFIDENCE=0.35
STEP_TIMEOUT_SEC=30
MAX_REQUEST_CHARS=2000

# --- workflow sources, data and outputs -----------------------------------------------------
WORKFLOW_EXCEL=data/AI_Agent_Workflow_Assessment.xlsx
WORKFLOW_BINDINGS=config/workflow_bindings.yaml
OUTPUT_DIR=outputs
UPLOAD_DIR=runs/uploads
# tools can only read files under these folders
ALLOWED_DATA_DIRS=data,runs,outputs
# hosts allowed for https:// data sources (empty = none)
ALLOWED_SOURCE_HOSTS=

# --- persistence ----------------------------------------------------------------------------
# Run history and paused-run checkpoints. Default: sqlite:///runs/agent.db
DATABASE_URL=
# DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# defaults to DATABASE_URL; "memory" = not persisted
CHECKPOINT_URL=
ALLOW_SQLITE_IN_PRODUCTION=

# --- integrations (empty = simulated services from data/sample) -----------------------------
ORDERS_API_URL=
ORDERS_API_TOKEN=
CARRIER_API_URL=
CARRIER_API_TOKEN=
HTTP_TIMEOUT_SEC=10

# --- HTTP API -------------------------------------------------------------------------------
# comma-separated; clients send X-API-Key or Authorization: Bearer
API_KEYS=
# 1 only behind a gateway that already authenticates
AUTH_DISABLED=
# per API key
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=10
# comma-separated origins, e.g. https://app.example.com
CORS_ORIGINS=

# --- logging --------------------------------------------------------------------------------
LOG_LEVEL=INFO
# 1 = one JSON object per line
LOG_JSON=
